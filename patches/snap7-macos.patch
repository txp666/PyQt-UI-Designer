Snap7 modern macOS compatibility
Base: davenardella/snap7 30f37da3114024a71ba93f7fd855c680b97a406f
Applied only to the build-tree copy on APPLE; upstream submodule remains unchanged.
Our minimum macOS 14.4 has native monotonic clocks and SO_NOSIGPIPE.

diff --git a/src/sys/snap_sysutils.h b/src/sys/snap_sysutils.h
--- a/src/sys/snap_sysutils.h
+++ b/src/sys/snap_sysutils.h
@@ -28,9 +28,6 @@
 //---------------------------------------------------------------------------
 #include "snap_platform.h"
 //---------------------------------------------------------------------------
-#ifdef OS_OSX
-# define CLOCK_MONOTONIC 0
-#endif
 
 longword SysGetTick();
 void SysSleep(longword Delay_ms);
diff --git a/src/sys/snap_sysutils.cpp b/src/sys/snap_sysutils.cpp
--- a/src/sys/snap_sysutils.cpp
+++ b/src/sys/snap_sysutils.cpp
@@ -26,17 +26,7 @@
 
 #include "snap_sysutils.h"
 
-#ifdef OS_OSX
-int clock_gettime(int clk_id, struct timespec* t) 
-{
-    struct timeval now;
-    int rv = gettimeofday(&now, NULL);
-    if (rv) return rv;
-    t->tv_sec  = now.tv_sec;
-    t->tv_nsec = now.tv_usec * 1000;
-    return 0;
-}
-#endif
+// Modern macOS provides native clock_gettime(CLOCK_MONOTONIC).
 
 //---------------------------------------------------------------------------
 longword SysGetTick()
