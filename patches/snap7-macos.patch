diff --git a/src/sys/snap_msgsock.cpp b/src/sys/snap_msgsock.cpp
--- a/src/sys/snap_msgsock.cpp
+++ b/src/sys/snap_msgsock.cpp
@@ -269,6 +269,15 @@
     int NoDelay = 1;
 	int KeepAlive = 1;
     LastTcpError=0;
+#ifdef OS_OSX
+    // Both CreateSocket() and accepted SetSocket() use this path. Avoid
+    // SIGPIPE on a disconnected peer without changing process-wide signals.
+    int NoSigPipe = 1;
+    SockCheck(setsockopt(FSocket, SOL_SOCKET, SO_NOSIGPIPE,
+                         (char*)&NoSigPipe, sizeof(NoSigPipe)));
+    if (LastTcpError != 0)
+        return;
+#endif
     SockCheck(setsockopt(FSocket, IPPROTO_TCP, TCP_NODELAY,(char*)&NoDelay, sizeof(NoDelay)));
 
