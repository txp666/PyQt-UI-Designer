Snap7 bounded TCP connection attempts
Base: davenardella/snap7 30f37da3114024a71ba93f7fd855c680b97a406f
Applied only to a build-tree copy. PingTimeout bounds TCP connect; no protocol changes.

diff --git a/src/sys/snap_msgsock.h b/src/sys/snap_msgsock.h
--- a/src/sys/snap_msgsock.h
+++ b/src/sys/snap_msgsock.h
@@ -37,7 +37,7 @@
 // i.e. raw socket pinger is not more used.
 // Thanks to Rolf Stalder that made it ;)
 //----------------------------------------------------------------------------
-#ifdef PLATFORM_UNIX
+#if defined(PLATFORM_UNIX) || defined(OS_OSX)
     #define NON_BLOCKING_CONNECT
 #endif
 #ifdef NON_BLOCKING_CONNECT
