      },
      "properties": {
        "minimum": -30000,
        "maximum": 30000,
        "value": 0,
        "sendOnChange": true,
        "commandMode": "S7",
        "commandTargetId": "plc-main",
        "s7Command": {
          "address": "DB1.DBW2",
          "dataType": "INT",
          "value": "1",
          "onValue": "1",
          "offValue": "0"
        }
      }
    },
    {
      "id": "spin",
      "type": "SpinBox",
      "geometry": {
        "x": 264,
        "y": 478,
        "w": 228,
        "h": 40
      },
      "properties": {
        "minimum": -30000,
        "maximum": 30000,
        "value": 0,
        "sendOnChange": true,
        "commandMode": "S7",
        "commandTargetId": "plc-main",
        "s7Command": {
          "address": "DB1.DBW2",
          "dataType": "INT",
          "value": "1",
          "onValue": "1",
          "offValue": "0"
        }
      }
    },
    {
      "id": "speed-combo",
      "type": "ComboBox",
      "geometry": {
        "x": 508,
        "y": 478,
        "w": 228,
        "h": 40
      },
      "properties": {
        "items": "Low\nHigh",
        "currentIndex": 0,
        "commands": "1200\n2400",
        "sendOnSelect": true,
        "commandMode": "S7",
        "commandTargetId": "plc-main",
        "s7Command": {
          "address": "DB1.DBW2",
          "dataType": "INT",
          "value": "1",
          "onValue": "1",
          "offValue": "0"
        }
      }
    },
    {
      "id": "trend",
      "type": "RealtimeChart",
      "geometry": {
        "x": 20,
        "y": 540,
        "w": 716,
        "h": 200
      },
      "properties": {
        "title": "PLC sine",
        "curveCount": 1,
        "_curve_0_name": "Sine (20–80)",
        "_curve_0_parseMode": "S7",
        "_curve_0_sourceCardId": "plc-main",
        "_curve_0_s7": {
          "address": "DB1.DBD20",
          "dataType": "REAL",
          "period": 100
        }
      }
    },
    {
      "id": "temperature-gauge",
      "type": "GaugeMeter",
      "geometry": {
        "x": 752,
        "y": 462,
        "w": 228,
        "h": 180
      },
      "properties": {
        "title": "Temperature",
        "unit": "°C",
        "minimum": -50,
        "maximum": 150
      },
      "binding": {
        "parseMode": "S7",
        "sourceCardId": "plc-main",
        "s7": {
          "address": "DB1.DBD16",
          "dataType": "REAL",
          "period": 0
        }
      }
    }
  ],
  "serial": {
    "parser": "line"
  }
}
